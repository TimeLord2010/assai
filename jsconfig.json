{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strictNullChecks": true,
    "module": "nodenext",
    "target": "ES2022",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "declaration": true,
    "strictPropertyInitialization": true,
    "lib": ["ES2022"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  }
}
